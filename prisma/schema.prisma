generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id                String  @id @default(uuid())
  name              String
  role              String
  email             String  @unique
  startDate         String?
  baseSalary        Float
  probationSalary   Float   @default(15000)
  commissionRate    Float
  target            Int
  managerId         String?
  probationDuration Int
  isProbation       Boolean
  failedMonths      Int
  penalty           Int
  sessionVersion    Int     @default(1)
  chatParticipations ConversationParticipant[]
  messages          Message[]
  reactions         Reaction[]
  starredMessages   StarredMessage[]
  avatarUrl         String? @db.Text
  lastSeenAt        DateTime? @default(now())
  panNumber         String?
  aadhaarNumber     String?
  lastLogin         DateTime?
  customFields      Json?     @default("{}")
  pushSubscriptions PushSubscription[]
}

model Lead {
  leadId      String    @id @default(uuid())
  employeeId  String
  date        String
  status      String
  name        String
  email       String?
  phone       String?
  linkedIn    String?
  objections  String?
  nextAction  String?
  followUp    String
  notes       String    @db.Text
  createdAt   DateTime  @default(now())
  convertedAt DateTime?
  customFields Json?    @default("{}")
}

model CustomFieldDefinition {
  id          String   @id @default(uuid())
  entityType  String   // "LEAD" or "EMPLOYEE"
  name        String   // Key name
  label       String   // UI Label
  type        String   // "text", "number", "date", "select"
  options     String?  @db.Text // JSON string array for select options
  required    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([entityType, name])
}

model Expense {
  expenseId   String @id @default(uuid())
  employeeId  String
  date        String
  amount      Float
  description String
  status      String
}

model PTO {
  ptoId      String @id @default(uuid())
  employeeId String
  startDate  String
  endDate    String
  status     String
}

model Setting {
  key   String @id
  value String
}

model AuditLog {
  id         String   @id @default(uuid())
  employeeId String
  action     String
  details    String   // JSON stringified payload
  timestamp  DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  message     String
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Invoice {
  id           String   @id @default(uuid())
  employeeId   String
  month        String
  conversions  Int      @default(0)
  baseSalary   Float    @default(0)
  commission   Float    @default(0)
  grossAmount  Float    @default(0)
  tdsDeduction Float    @default(0)
  amount       Float
  status       String   @default("Generated")
  createdAt    DateTime @default(now())
}

model OffboardRequest {
  id          String   @id @default(uuid())
  employeeId  String
  requestedBy String
  status      String   @default("Pending") // Pending, Approved, Rejected
  createdAt   DateTime @default(now())
}

model Conversation {
  id           String     @id @default(uuid())
  type         String     @default("DIRECT") // DIRECT or GROUP
  isReadOnly   Boolean    @default(false)
  restrictedTo String[]   @default([])
  name         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  employeeId     String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())
  lastDeliveredAt DateTime    @default(now())
  isPinned       Boolean      @default(false)
  isArchived     Boolean      @default(false)
  clearedAt      DateTime?    @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([conversationId, employeeId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime     @default(now())
  isDeleted      Boolean      @default(false)
  isEdited       Boolean      @default(false)
  editHistory    Json?
  attachmentUrl  String?
  attachmentType String?
  linkMetadata   Json?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         Employee     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Message?     @relation("MessageReplies", fields: [parentId], references: [id])
  replies        Message[]    @relation("MessageReplies")
  reactions      Reaction[]
  starredBy      StarredMessage[]
}

model Reaction {
  id         String   @id @default(uuid())
  emoji      String
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([messageId, employeeId, emoji])
}

model StarredMessage {
  id         String   @id @default(uuid())
  employeeId String
  messageId  String
  createdAt  DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([employeeId, messageId])
}


model PushSubscription {
  id         String   @id @default(uuid())
  employeeId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model CooWorkSession {
  id                String    @id @default(uuid())
  employeeId        String
  pillar            String    // PILLAR_1_ONBOARDING..PILLAR_5_ALIGNMENT
  taskTitle         String
  notes             String    @default("") @db.Text
  startedAt         DateTime  @default(now())
  lastHeartbeatAt   DateTime  @default(now())
  endedAt           DateTime?
  durationMinutes   Int       @default(0)
  status            String    @default("ACTIVE") // ACTIVE, COMPLETED, AUTO_PAUSED_IDLE, FLAGGED_BY_FOUNDER
  relatedLeadId     String?
  verifiedByFounder Boolean   @default(true)
}

model CooWeeklyReport {
  id                          String   @id @default(uuid())
  employeeId                  String
  weekStartDate               String   // ISO Monday YYYY-MM-DD
  weekEndDate                 String   // ISO Sunday YYYY-MM-DD
  deadlineAt                  DateTime
  submittedAt                 DateTime @default(now())
  isOnTime                    Boolean  @default(true)
  totalHoursLogged            Float    @default(0)
  venuesOnboardedCount        Int      @default(0)
  activeTrialsMonitoredCount  Int      @default(0)
  fieldDemosVerifiedCount     Int      @default(0)
  b2bMilestonesDelivered      String   @db.Text
  merchantEscalationsResolved String   @db.Text
  nextWeekPriorities          String   @db.Text
  founderAcknowledged         Boolean  @default(false)
  founderNotes                String?  @db.Text
}

model CooMonthlyLedger {
  id                         String    @id @default(uuid())
  month                      String    @unique // YYYY-MM
  hoursLogged                Float     @default(0)
  weeklyReportsSubmitted     Int       @default(0)
  weeklyReportsRequired      Int       @default(4)
  qualifiesAsCompletedMonth  Boolean   @default(false)
  isEmergencyPause           Boolean   @default(false)
  pauseReason                String?
  grossSettledInSbi          Float     @default(0)
  gstExcluded                Float     @default(0)
  gatewayAndRefundDeductions Float     @default(0)
  netRealizedRevenue         Float     @default(0)
  cooActiveSharePercent      Float     @default(3.0)
  grossCooPayout             Float     @default(0)
  tdsDeducted                Float     @default(0)
  netCooPayout               Float     @default(0)
  disbursementStatus         String    @default("PENDING") // PENDING, STATEMENT_ISSUED, PAID, FORFEITED
  settledAt                  DateTime?
}

model MerchantDeployment {
  id                  String   @id @default(uuid())
  leadId              String?
  venueName           String
  venueType           String   @default("Restaurant") // Restaurant, Cafe, Cloud Kitchen, Hotel, Lounge
  onboardingStatus    String   @default("TRIAL_21_DAY") // TRIAL_21_DAY, MODULE_SETUP, LIVE_ACTIVE, AT_RISK, CHURNED
  trialStartDate      String?
  trialEndsAt         String?
  subscribedModules   Json     @default("[]")
  annualContractValue Float    @default(0)
  demoVerifiedByCoo   Boolean  @default(false)
  slaGoLiveDate       String?
  lastHealthAuditDate String?
  notes               String?  @db.Text
  updatedAt           DateTime @updatedAt
}
