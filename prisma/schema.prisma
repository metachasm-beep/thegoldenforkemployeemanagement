generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id                String  @id @default(uuid())
  name              String
  role              String
  email             String  @unique
  startDate         String?
  baseSalary        Float
  commissionRate    Float
  target            Int
  managerId         String?
  probationDuration Int
  isProbation       Boolean
  failedMonths      Int
  penalty           Int
  sessionVersion    Int     @default(1)
  avatarUrl         String? @db.Text
  panNumber         String?
  aadhaarNumber     String?
}

model Lead {
  leadId      String    @id @default(uuid())
  employeeId  String
  date        String
  status      String
  assignee    String
  followUp    String
  notes       String
  createdAt   DateTime  @default(now())
  convertedAt DateTime?
}

model Expense {
  expenseId   String @id @default(uuid())
  employeeId  String
  date        String
  amount      Float
  description String
  status      String
}

model PTO {
  ptoId      String @id @default(uuid())
  employeeId String
  startDate  String
  endDate    String
  status     String
}

model Setting {
  key   String @id
  value String
}

model AuditLog {
  id         String   @id @default(uuid())
  employeeId String
  action     String
  details    String   // JSON stringified payload
  timestamp  DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  message     String
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Invoice {
  id           String   @id @default(uuid())
  employeeId   String
  month        String
  conversions  Int      @default(0)
  baseSalary   Float    @default(0)
  commission   Float    @default(0)
  grossAmount  Float    @default(0)
  tdsDeduction Float    @default(0)
  amount       Float
  status       String   @default("Generated")
  createdAt    DateTime @default(now())
}
